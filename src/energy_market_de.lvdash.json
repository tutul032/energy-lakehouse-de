{
  "datasets": [
    {
      "catalog": "workspace",
      "displayName": "ds_daily_kpis",
      "name": "0a3a71ba",
      "queryLines": [
        "SELECT date_local,\r\n",
        "       round(total_load_mwh / 1000, 1)      AS load_gwh,\r\n",
        "       round(price_avg_eur_mwh, 1)          AS avg_price,\r\n",
        "       round(renewables_share_avg * 100, 1) AS renewables_pct\r\n",
        "FROM gold_energy_daily\r\n",
        "WHERE date_local = (SELECT max(date_local) FROM gold_energy_daily WHERE is_complete)"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_hourly_14d",
      "name": "90e9a270",
      "queryLines": [
        "SELECT hour_local, total_load_mwh, price_eur_mwh, solar_mwh, wind_onshore_mwh, wind_offshore_mwh,\r\n",
        "       lignite_mwh, hard_coal_mwh, natural_gas_mwh, renewables_share\r\n",
        "FROM gold_energy_hourly\r\n",
        "WHERE hour_utc >= current_timestamp() - INTERVAL 14 DAYS"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_merit_order",
      "name": "6f1699f4",
      "queryLines": [
        "SELECT round(wind_speed_100m_onshore_avg_ms) AS wind_ms, round(avg(price_eur_mwh), 1) AS avg_price,\r\n",
        "       round(avg(renewables_share), 2) AS ren_share, count(*) AS hours\r\n",
        "FROM gold_energy_weather_hourly\r\n",
        "WHERE wind_speed_100m_onshore_avg_ms IS NOT NULL AND hour(hour_local) BETWEEN 0 AND 5\r\n",
        "GROUP BY 1 HAVING count(*) >= 20 ORDER BY 1"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_forecast_tomorrow",
      "name": "44649444",
      "queryLines": [
        "WITH f AS (\r\n",
        "  SELECT target_hour_local, target, forecast FROM gold_forecast_hourly\r\n",
        "  WHERE issue_date = (SELECT max(issue_date) FROM gold_forecast_hourly)\r\n",
        ")\r\n",
        "SELECT f.target_hour_local, f.target, f.forecast,\r\n",
        "       CASE f.target WHEN 'total_load_mwh' THEN h.total_load_mwh ELSE h.price_eur_mwh END AS same_hour_last_week\r\n",
        "FROM f LEFT JOIN gold_energy_hourly h ON h.hour_local = f.target_hour_local - INTERVAL 7 DAYS"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_forecast_vs_actual",
      "name": "17ae361a",
      "queryLines": [
        "SELECT f.target_hour_local, f.target, f.forecast,\r\n",
        "       CASE f.target WHEN 'total_load_mwh' THEN h.total_load_mwh ELSE h.price_eur_mwh END AS actual\r\n",
        "FROM gold_forecast_hourly f\r\n",
        "JOIN gold_energy_hourly h ON h.hour_utc = f.target_hour_utc\r\n",
        "WHERE f.issue_date >= date_sub(to_date(from_utc_timestamp(current_timestamp(), 'Europe/Berlin')), 14)"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_accuracy",
      "name": "b0e99bee",
      "queryLines": [
        "SELECT issue_date, target, n_hours, round(mae, 1) AS mae, round(baseline_mae, 1) AS baseline_mae,\r\n",
        "       round(mape, 2) AS mape, mae < baseline_mae AS model_better\r\n",
        "FROM gold_forecast_accuracy ORDER BY issue_date DESC"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_dq_counts",
      "name": "6639fbad",
      "queryLines": [
        "SELECT to_date(from_utc_timestamp(detected_at, 'Europe/Berlin')) AS day, severity, check_name, count(*) AS n\r\n",
        "FROM gold_dq_anomalies WHERE entity NOT LIKE 'TEST:%' GROUP BY 1, 2, 3"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_dq_top",
      "name": "4e0d20cc",
      "queryLines": [
        "SELECT check_name, entity, ts_utc, round(value) AS value, round(expected) AS expected,\r\n",
        "       round(score, 1) AS score, severity, reason\r\n",
        "FROM gold_dq_anomalies\r\n",
        "WHERE entity NOT LIKE 'TEST:%'\r\n",
        "  AND detected_at >= (SELECT max(detected_at) FROM gold_dq_anomalies) - INTERVAL 1 HOUR\r\n",
        "ORDER BY CASE severity WHEN 'critical' THEN 0 ELSE 1 END, abs(score) DESC\r\n",
        "LIMIT 15"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_dq_summary",
      "name": "87a530fa",
      "queryLines": [
        "SELECT detection_date, model, summary_text FROM gold_dq_daily_summary_text\r\n",
        "ORDER BY detection_date DESC LIMIT 1"
      ],
      "schema": "energy_dev"
    },
    {
      "catalog": "workspace",
      "displayName": "ds_freshness",
      "name": "b0d095ac",
      "queryLines": [
        "SELECT 'energy' AS source, max(hour_utc) AS latest_utc FROM gold_energy_hourly\r\n",
        "UNION ALL SELECT 'weather (observed)', max(hour_utc) FROM gold_energy_weather_hourly WHERE wind_speed_100m_onshore_avg_ms IS NOT NULL\r\n",
        "UNION ALL SELECT 'forecast issued', max(issue_time_utc) FROM gold_forecast_hourly"
      ],
      "schema": "energy_dev"
    }
  ],
