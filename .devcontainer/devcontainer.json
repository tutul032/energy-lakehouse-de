{
  "name": "energy-lakehouse-de",
  // Python minor = .python-version / CI (3.12); Debian trixie like the extractor image.
  "image": "mcr.microsoft.com/devcontainers/python:3.3.2-3.12-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      "version": "2.103.3"
    },
    // Host Docker via the socket, so `docker build .` works inside (no Docker daemon in here).
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.1": {
      "version": "29.9.2",
      "moby": false
    },
    // Official install script (databricks/setup-cli) at a pinned tag; same version as CI.
    "./features/databricks-cli": {
      "version": "1.22.1"
    }
  },
  "remoteUser": "vscode",
  // The Linux venv lives outside the bind-mounted workspace, so it never clobbers a host .venv.
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/energy-lakehouse-de",
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.venvs/energy-lakehouse-de/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Callback port of `databricks auth login` (OAuth U2M): the host browser redirects here.
  "forwardPorts": [8020],
  "portsAttributes": {
    "8020": {
      "label": "databricks auth login callback",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "databricks.databricks",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/energy-lakehouse-de/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
