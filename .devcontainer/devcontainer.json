{
  "name": "energy-lakehouse-de",
  // Base image (FROM) in .devcontainer/Dockerfile; Python minor = .python-version / CI (3.12).
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Host Docker via the socket, so `docker build .` works inside (no Docker daemon in here).
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // Official install script (databricks/setup-cli) at a pinned tag; same version as CI.
    "./features/databricks-cli": {
      "version": "1.23.0"
    },
    // Terraform (terraform/) and tflint; same versions as the ci.yml `terraform` job.
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.16.6",
      "tflint": "0.64.0"
    },
    // Azure CLI for infra/azure (Lab 13): log in with `az login --use-device-code`.
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "2.92.0"
    }
  },
  "remoteUser": "vscode",
  // CLI logins made inside the container survive a rebuild: named Docker volumes (never bind
  // mounts of host credential folders). post-create.sh chowns them to vscode.
  "mounts": [
    {
      "source": "energy-lakehouse-de-azure",
      "target": "/home/vscode/.azure",
      "type": "volume"
    },
    {
      "source": "energy-lakehouse-de-databricks",
      "target": "/home/vscode/.databricks",
      "type": "volume"
    }
  ],
  // The Linux venv lives outside the bind-mounted workspace, so it never clobbers a host .venv.
  // The Databricks config file lives in the persisted ~/.databricks volume. Host and profile
  // are not secrets (host = databricks.yml workspace.host).
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/energy-lakehouse-de",
    "UV_LINK_MODE": "copy",
    "DATABRICKS_CONFIG_FILE": "/home/vscode/.databricks/databrickscfg",
    "DATABRICKS_CONFIG_PROFILE": "free",
    "TF_VAR_databricks_host": "https://dbc-405898bc-c90e.cloud.databricks.com"
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.venvs/energy-lakehouse-de/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // Callback port of `databricks auth login` (OAuth U2M): the host browser redirects here.
  "forwardPorts": [8020],
  "portsAttributes": {
    "8020": {
      "label": "databricks auth login callback",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "databricks.databricks",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/energy-lakehouse-de/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
